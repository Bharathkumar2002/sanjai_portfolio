# Copy this file to .env.local and fill in the values.
# Never commit .env.local. In Vercel, add the same keys under Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Both are safe to expose:
# all access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Public URL of the deployed site (used for sitemap, canonical URLs and Open Graph).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Random string used to hash visitor IPs for contact-form rate limiting (no raw IPs are stored).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_HASH_SALT=change-me

# NOTE: the Supabase service-role key is NOT needed and must never be added here.
