# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel, add the same four variables under Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon key. Safe to expose: access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Public URL of the site (sitemap, canonical URLs, social previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Random string used to hash visitor IPs for contact-form rate limiting.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_HASH_SALT=change-me

# Do NOT add the Supabase service-role key — it is not needed anywhere.
# For the one-off `npm run assets:upload`, pass ADMIN_EMAIL / ADMIN_PASSWORD in the shell instead of saving them here.
